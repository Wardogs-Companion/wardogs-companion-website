---
// Layout shared by the legal pages. Their texts are the Markdown files in src/content/legal,
// shown exactly as written: to update a text, replace its file.
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import * as privacyEn from '../content/legal/privacy-policy.en.md';
import * as privacyFr from '../content/legal/politique-de-confidentialite.fr.md';
import * as termsEn from '../content/legal/terms-of-use.en.md';
import * as termsFr from '../content/legal/conditions-d-utilisation.fr.md';

const documents = {
  privacy: { en: privacyEn, fr: privacyFr, label: 'footer.privacy', description: 'privacy.description' },
  terms: { en: termsEn, fr: termsFr, label: 'footer.terms', description: 'terms.description' },
} as const;

interface Props {
  lang: Lang;
  // Also the page's route: /privacy, /fr/privacy, and so on.
  doc: keyof typeof documents;
}

const { lang, doc } = Astro.props;
const t = useTranslations(lang);
const legal = documents[doc];
const { Content, getHeadings } = legal[lang];
// The title comes from the text's own heading, so it stays right when the file is replaced.
const heading = getHeadings().find((h) => h.depth === 1)?.text ?? t(legal.label);
const otherLangs = (Object.keys(languages) as Lang[]).filter((code) => code !== lang);
---

<BaseLayout lang={lang} title={`${heading} · Wardogs Companion`} description={t(legal.description)}>
  <header class="top">
    <a class="home" href={getRelativeLocaleUrl(lang)}>
      Wardogs Companion
    </a>
    <nav aria-label={t('nav.switchLabel')}>
      {otherLangs.map((code) => (
        <a class="lang" href={getRelativeLocaleUrl(code, doc)} hreflang={code} lang={code}>
          {languages[code]}
        </a>
      ))}
    </nav>
  </header>

  <main class="legal">
    <Content />
  </main>

  <SiteFooter langs={[lang]} />
</BaseLayout>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 4vw, 2rem);
  }

  .home {
    font-weight: 700;
    text-decoration: none;
  }

  .home:hover {
    text-decoration: underline;
  }

  .lang {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* The Markdown is rendered outside this component's scope, hence :global() inside .legal. */
  .legal {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2.5rem) 1rem 2rem;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .legal :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    line-height: 1.15;
  }

  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .legal :global(ul) {
    padding-left: 1.25rem;
  }

  .legal :global(li + li) {
    margin-top: 0.4rem;
  }

  .legal :global(a) {
    text-underline-offset: 0.15em;
  }

  .legal :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--color-panel);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  /* Wide tables scroll sideways on small screens instead of widening the page or squeezing their columns. */
  .legal :global(table) {
    display: block;
    overflow-x: auto;
    margin: 1.25rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .legal :global(table code) {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  /* The contact address is one long word: let it wrap so it does not widen its table on a phone. */
  .legal :global(td a) {
    overflow-wrap: anywhere;
  }

  .legal :global(th),
  .legal :global(td) {
    min-width: 7.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    text-align: left;
    vertical-align: top;
  }

  /* On a phone, tables with many columns get wider cells, so long cells do not turn into very tall rows. */
  @media (max-width: 40rem) {
    .legal :global(table:has(th:nth-child(4)) :is(th, td)) {
      min-width: 12rem;
    }
  }

  .legal :global(th) {
    background: var(--color-panel);
  }
</style>
