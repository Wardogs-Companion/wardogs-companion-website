---
import { consoleMedia, introMedia } from 'virtual:wardogs/game-media';
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroFilm from './IntroFilm.astro';
import SiteFooter from './SiteFooter.astro';
import Station from './Station.astro';
import { stationTexts, type StationTexts } from '../i18n/station';
import { sectionPath } from '../scripts/station/sections.js';
import { DISCORD_INVITE, TWITCH_EXTENSION } from '../scripts/station/links.js';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // a section's own address (src/pages/[section].astro): the page opens on it, its name in the title
  section?: string;
}

// The presentation and the console's EXTENSION page offer to install the extension from its page on Twitch: no home
// page built without that address (links.js), so that no page ever offers a button to nowhere.
if (!/^https:\/\/([a-z]+\.)?twitch\.tv\/\S+$/.test(TWITCH_EXTENSION))
  throw new Error(
    "src/scripts/station/links.js: TWITCH_EXTENSION, the extension's page on Twitch, is not set",
  );

const { lang, section } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter((code) => code !== lang);
// (without the console, a section's address is the home page itself)
const opened = consoleMedia && section ? (section as keyof StationTexts['titles']) : undefined;
const title = opened ? `${stationTexts[lang].titles[opened]} · ${t('meta.title')}` : t('meta.title');
const description = opened ? stationTexts[lang].summaries[opened] : t('meta.description');
const alternates = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((code) => [code, sectionPath(code, opened)]),
) as Record<Lang, string>;
---

<BaseLayout lang={lang} {title} {description} station={!!consoleMedia} section={opened} {alternates}>
  {/* The intro film first, over the presentation; only when the build has its media (see IntroFilm.astro). */}
  {introMedia && <IntroFilm lang={lang} media={introMedia} />}

  <div id="home">
    {/* The console, over the presentation, which stays the page without it (see Station.astro, station.css). */}
    {consoleMedia && <Station lang={lang} intro={!!introMedia} section={opened} />}
    <header class="top">
      {introMedia && (
        <button type="button" class="replay" id="intro-replay" hidden>
          <span class="if-motion">
            <span aria-hidden="true">↻</span> {t('intro.replay')}
          </span>
          <span class="if-reduced">{t('intro.watch')}</span>
        </button>
      )}
      <nav aria-label={t('nav.switchLabel')}>
        {otherLangs.map((code) => (
          <a class="lang" href={sectionPath(code, opened)} hreflang={code} lang={code}>
            {languages[code]}
          </a>
        ))}
      </nav>
    </header>

    <main class="hero" tabindex="-1">
      <h1 class="logo">
        <img src="/images/logo-horizontal.png" width="680" height="240" alt="Wardogs Companion" />
      </h1>
      <p class="status">{t('home.status')}</p>
      <p class="tagline">{t('home.tagline')}</p>
      <p class="lead">{t('home.lead')}</p>
      <p class="how">{t('home.how')}</p>
      <p class="state">
        <strong>{t('ext.state')}</strong> · {t('ext.stateText')}
      </p>
      <div class="actions">
        <a class="go install" href={TWITCH_EXTENSION}>
          {t('home.install')}
        </a>
        <a class="go" href={DISCORD_INVITE}>
          {t('home.join')}
        </a>
      </div>
    </main>

    <SiteFooter langs={[lang]} />
  </div>
</BaseLayout>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
    padding: 1rem clamp(1rem, 4vw, 2rem);
  }

  .lang {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* Plays the intro film again: discreet, beside the language. */
  .replay {
    padding: 0.35rem 0.25rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .replay:hover {
    color: var(--color-text);
  }

  /* Where animations are reduced, the film never starts by itself: the control offers it, as a button like the
     language's, so that it is seen. */
  .if-reduced {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .replay {
      padding: 0.35rem 0.8rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
    }
    .replay:hover {
      border-color: var(--color-text);
    }
    .if-motion {
      display: none;
    }
    .if-reduced {
      display: inline;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2rem, 10vh, 6rem) 1rem 3rem;
    text-align: center;
  }

  /* (the focus comes here after the intro, by script only: no outline around the whole section) */
  .hero:focus {
    outline: none;
  }

  .logo {
    margin: 0;
    width: min(100%, 34rem);
    line-height: 0;
  }

  .status {
    margin: 0;
    padding: 0.3rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: color-mix(in srgb, var(--color-accent) 70%, white);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tagline {
    margin: 0.5rem 0 0;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .lead {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .how {
    max-width: 36rem;
    margin: 0;
    color: var(--color-muted);
  }

  /* The extension's state (available: green, as the console says it), then where to install it and where to talk
     about it: the extension's page on Twitch first, the Discord server beside it */
  .state {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }

  .state strong {
    color: color-mix(in srgb, var(--team-manticore) 70%, white);
    font-weight: 600;
  }

  .state strong::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--team-manticore);
    vertical-align: 0.08em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .go {
    padding: 0.6rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .go:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .go.install {
    border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  .go.install:hover {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
</style>
