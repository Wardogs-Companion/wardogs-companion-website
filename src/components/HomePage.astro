---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { introMedia } from 'virtual:wardogs/intro-media';
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroFilm from './IntroFilm.astro';
import SiteFooter from './SiteFooter.astro';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter((code) => code !== lang);
---

<BaseLayout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  {/* The intro film first, over the presentation; only when the build has its media (see IntroFilm.astro). */}
  {introMedia && <IntroFilm lang={lang} media={introMedia} />}

  <div id="home">
    <header class="top">
      {introMedia && (
        <button type="button" class="replay" id="intro-replay" hidden>
          <span aria-hidden="true">↻</span> {t('intro.replay')}
        </button>
      )}
      <nav aria-label={t('nav.switchLabel')}>
        {otherLangs.map((code) => (
          <a class="lang" href={getRelativeLocaleUrl(code)} hreflang={code} lang={code}>
            {languages[code]}
          </a>
        ))}
      </nav>
    </header>

    <main class="hero" tabindex="-1">
      <h1 class="logo">
        <img src="/images/logo-horizontal.png" width="680" height="240" alt="WARDOGS Companion" />
      </h1>
      <p class="status">{t('home.status')}</p>
      <p class="tagline">{t('home.tagline')}</p>
      <p class="lead">{t('home.lead')}</p>
    </main>

    <SiteFooter langs={[lang]} />
  </div>
</BaseLayout>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
    padding: 1rem clamp(1rem, 4vw, 2rem);
  }

  .lang {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* Plays the intro film again: discreet, beside the language. */
  .replay {
    padding: 0.35rem 0.25rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .replay:hover {
    color: var(--color-text);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2rem, 10vh, 6rem) 1rem 3rem;
    text-align: center;
  }

  /* (the focus comes here after the intro, by script only: no outline around the whole section) */
  .hero:focus {
    outline: none;
  }

  .logo {
    margin: 0;
    width: min(100%, 34rem);
    line-height: 0;
  }

  .status {
    margin: 0;
    padding: 0.3rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: color-mix(in srgb, var(--color-accent) 70%, white);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tagline {
    margin: 0.5rem 0 0;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .lead {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }
</style>
