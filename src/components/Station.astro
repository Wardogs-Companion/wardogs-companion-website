---
// The home page's console (src/scripts/station/station.js), over the home page's presentation, which stays its fallback
// (station.css). Rendered only when the build has its media (src/integrations/game-media.mjs); its script meets the
// intro film's in src/scripts/home.js.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { consoleMedia } from 'virtual:wardogs/game-media';
import { version } from '../../package.json';
import { stationTexts } from '../i18n/station';
import { sectionPath } from '../scripts/station/sections.js';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import '../styles/station.css';

interface Props {
  lang: Lang;
  // The intro film is on the page: the corner offers to replay it.
  intro: boolean;
  // The page is a section's own address: the languages lead to the same section (station.js keeps them so).
  section?: string;
}

const { lang, intro, section } = Astro.props;
const t = useTranslations(lang);
const codes = Object.keys(languages) as Lang[];
---

{/* (the first paint's state, before the script runs: the room dark, the HUD hidden; its script claims it, data-state) */}
<div
  id="station"
  class="room-dark hud-hidden"
  role="main"
  tabindex="-1"
  data-media={consoleMedia}
  data-lang={lang}
>
  <div id="st-world">
    <img id="st-dark" class="room" alt="" />
    <img id="st-lit" class="room" alt="" />
    <div id="st-lit-bays"></div>
    <div id="st-pieces"></div>
    <div id="st-keys"></div>
    <div id="st-screens"></div>
    <div id="st-fx" aria-hidden="true">
      <div id="st-lamps"></div>
      <div id="st-needles"></div>
    </div>
    <div id="st-posts"></div>
    <div id="st-controls"></div>
    <div id="st-focus"></div>
    <div id="st-focus-in"></div>
    <div id="st-edge"></div>
    <div id="st-rim"></div>
  </div>
  <div id="st-shield"></div>
  <div id="st-vignette"></div>
  <div id="st-curtain"></div>
  <div id="st-curtain-edge"></div>
  <div id="st-page" hidden>
    <div id="st-page-head">
      <div class="ph-line">
        <span class="sq" aria-hidden="true"></span>
        <span class="ph-path" id="st-page-path" aria-hidden="true"></span>
        <i class="rule" aria-hidden="true"></i>
        <nav class="ph-nav" id="st-page-nav"></nav>
      </div>
    </div>
    <div id="st-page-foot"></div>
    <div class="view" id="st-page-view" role="region" tabindex="0">
      <article class="pg" id="st-page-body"></article>
      {/* (a small window's: the legal lines and the controls' row while the page shows, station.js footPlace) */}
      <div class="pg-end" id="st-page-end"></div>
    </div>
    <i class="scan" id="st-page-scan" aria-hidden="true"></i>
  </div>
  <h1 class="hud tl">
    <span class="sq"></span>Wardogs Companion
  </h1>
  <button type="button" id="st-back" hidden aria-keyshortcuts="Escape">
    <i class="c tl"></i>
    <i class="c tr"></i>
    <i class="c bl"></i>
    <i class="c br"></i>
    <span id="st-back-txt"></span>
    <span class="key" id="st-back-key"></span>
  </button>
  <div id="st-factions" role="group">
    <p></p>
    <div class="row"></div>
  </div>
  <nav id="st-sections"></nav>
  <p id="st-pad-status" class="sr" role="status"></p>
  <p id="st-faction-status" class="sr" role="status"></p>
  <nav class="hud tr" aria-label={t('nav.switchLabel')}>
    {codes.map((code, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> / </span>}
        <a
          href={sectionPath(code, section)}
          hreflang={code}
          lang={code}
          title={languages[code]}
          aria-current={code === lang ? 'page' : undefined}
        >
          {code.toUpperCase()}
        </a>
      </>
    ))}
  </nav>
  {intro && (
    <button type="button" class="hud" id="st-intro-replay" hidden>
      <span class="if-motion">
        <span aria-hidden="true">↻</span> {t('intro.replay')}
      </span>
      <span class="if-reduced">{t('intro.watch')}</span>
    </button>
  )}
  <section id="st-call" hidden>
    <span class="plate"></span>
    <i class="c tl"></i>
    <i class="c tr"></i>
    <i class="c bl"></i>
    <i class="c br"></i>
    <div class="call-head">
      <canvas class="call-mark"></canvas>
      <div class="call-titles">
        <p class="call-kicker">
          <span id="st-call-name"></span>
          <span class="time" id="st-call-time" aria-hidden="true"></span>
        </p>
        <p class="call-title">
          <span id="st-call-state"></span>
          <span class="voice" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
        </p>
      </div>
    </div>
    <div class="talk" id="st-call-talk" aria-hidden="true"></div>
    <div class="sr" id="st-call-text"></div>
    <div class="acts">
      <a class="join" id="st-call-join" target="_blank" rel="noopener"></a>
      <button type="button" id="st-call-hang" aria-keyshortcuts="Escape"></button>
    </div>
  </section>
  <div id="st-power">
    <button type="button" id="st-power-btn"></button>
    <div class="tg-lock" aria-hidden="true">
      <i class="tg-corner tl"></i>
      <i class="tg-corner tr"></i>
      <i class="tg-corner bl"></i>
      <i class="tg-corner br"></i>
    </div>
    <i class="tg-lead" aria-hidden="true"></i>
    <i class="tg-end" aria-hidden="true"></i>
    <div id="st-power-tag" class="tg-tag" aria-hidden="true">
      <span class="plate"></span>
      <i class="c tl"></i>
      <i class="c tr"></i>
      <i class="c bl"></i>
      <i class="c br"></i>
      <p class="l1">
        <span class="sq"></span>
        <span id="st-pt-name"></span>
        <span class="st" id="st-pt-state"></span>
      </p>
      <p class="l2" id="st-pt-hint"></p>
    </div>
  </div>
  <div id="st-ctl-targets" aria-hidden="true"></div>
  <div id="st-power-line" aria-hidden="true">
    <span class="plate"></span>
    <span class="scan"></span>
    <span class="txt" id="st-pl-text"></span>
    <span class="count" id="st-pl-count"></span>
  </div>
  <div id="st-veil"></div>
  <div class="ctrl">
    <button type="button" id="st-skip"></button>
    <button type="button" id="st-motion" aria-pressed="true" hidden></button>
    <button type="button" id="st-sound" aria-pressed="false" hidden></button>
  </div>
  <div class="legal" id="st-legal">
    {/* (in the markup, so the required mention shows from the first paint; line 2 opens on the intro's credit when the
       film is on the page, station.js legalHandover; else on the console's own) */}
    <p id="st-legal1">
      {t('intro.legal1')}{' '}
      <span class="legal-links">
        <a href={getRelativeLocaleUrl(lang, 'privacy')}>{t('footer.privacy')}</a>
        <a href={getRelativeLocaleUrl(lang, 'terms')}>{t('footer.terms')}</a>
      </span>
      <span class="legal-version">{t('footer.version').replace('{version}', version)}</span>
    </p>
    <p id="st-legal2">{intro ? t('intro.legal2') : stationTexts[lang].legal2}</p>
  </div>
</div>

<script>
  import { mountStation, stationState } from '../scripts/station/station.js';
  import { filmIsPlaying, stationMounted } from '../scripts/home.js';

  const root = document.getElementById('station');
  if (root) {
    // (a script come so late that the style sheet has given the page to the presentation already: it keeps it)
    if (getComputedStyle(root).visibility === 'hidden') stationState(root, 'error');
    else
      try {
        stationMounted(mountStation(root, { held: filmIsPlaying() }));
      } catch (err) {
        stationState(root, 'error');
        throw err;
      }
  }
</script>
