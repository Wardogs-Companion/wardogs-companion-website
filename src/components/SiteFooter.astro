---
// Footer shared by every page: the unofficial-project notice, the copyright and the site's version, and the legal pages.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { version } from '../../package.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  // One language for a normal page, several for a bilingual page such as the 404.
  langs: Lang[];
}

const { langs } = Astro.props;
---

<footer class="site-footer">
  {langs.map((lang) => {
    const t = useTranslations(lang);
    return (
      <div lang={langs.length > 1 ? lang : undefined}>
        <p>{t('footer.disclaimer')}</p>
        <p>
          {t('footer.copyright')}{' '}
          <span class="version">· {t('footer.version').replace('{version}', version)}</span>
        </p>
        <nav class="legal-links" aria-label={t('footer.legalLabel')}>
          <a href={getRelativeLocaleUrl(lang, 'privacy')}>{t('footer.privacy')}</a>
          <a href={getRelativeLocaleUrl(lang, 'terms')}>{t('footer.terms')}</a>
          <a href={getRelativeLocaleUrl(lang, 'legal')}>{t('footer.legal')}</a>
        </nav>
      </div>
    );
  })}
</footer>

<style>
  .site-footer {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1rem 2.5rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    text-align: center;
  }

  p {
    margin: 0.4rem 0;
  }

  .version {
    white-space: nowrap;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    margin: 0.4rem 0;
  }

  .legal-links a {
    text-underline-offset: 0.15em;
  }

  .legal-links a:hover {
    color: var(--color-text);
  }
</style>
