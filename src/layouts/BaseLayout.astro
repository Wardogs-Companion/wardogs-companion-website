---
import '../styles/global.css';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** the page has the console (the home page, built with its media): data-station on the root element, empty until
   *  the console's script sets its state (station.css, station.js stationState) */
  station?: boolean;
  /** the console opens on this section (its own address, src/pages/[section].astro): data-section on the root
   *  element, read before anything is drawn (the intro skipped: seen-check.js) and by the console (station.js) */
  section?: string;
  /** this page's address in each language, as the site links to it ('/extension', '/fr/extension'): its canonical
   *  address, its versions for search engines (hreflang, the same as /sitemap.xml) and the og:url of its card;
   *  none on the 404 */
  alternates?: Record<Lang, string>;
}

const { lang, title, description, station = false, section, alternates } = Astro.props;
const t = useTranslations(lang);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = alternates && absolute(alternates[lang]);
// the languages as Open Graph names them
const locales: Record<Lang, string> = { en: 'en_US', fr: 'fr_FR' };
---

<!doctype html>
<html lang={lang} data-station={station ? '' : undefined} data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1011" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates &&
      (Object.keys(alternates) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={absolute(alternates[code])} />
      ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLang])} />}
    {/* (the card under a link shared on Discord, X, WhatsApp…: the page's title and description, and our logo) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wardogs Companion" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absolute('/images/og-card.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.imageAlt')} />
    <meta property="og:locale" content={locales[lang]} />
    {(Object.keys(locales) as Lang[])
      .filter((code) => code !== lang)
      .map((code) => (
        <meta property="og:locale:alternate" content={locales[code]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
