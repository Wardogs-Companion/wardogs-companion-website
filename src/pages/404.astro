---
// Single bilingual page: Vercel only serves /404.html. Its texts in both languages (src/i18n/ui.ts), English first.
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DISCORD_INVITE } from '../scripts/station/links.js';
import { useTranslations } from '../i18n/ui';

const en = useTranslations('en');
const fr = useTranslations('fr');
---

<BaseLayout
  lang="en"
  title={`${en('notFound.title')} · Wardogs Companion`}
  description={en('notFound.description')}
>
  <main class="not-found">
    <p class="code">404</p>
    <h1>{en('notFound.title')}</h1>
    <p lang="fr">{fr('notFound.title')}</p>
    <p>
      <a href="/">{en('notFound.home')}</a> ·{' '}
      <a href="/fr" lang="fr">
        {fr('notFound.home')}
      </a>
    </p>
    {/* A question: the Discord server, where help is given (each language on its own line where both do not fit). */}
    <p class="help">
      <span>
        {en('notFound.question')} <a href={DISCORD_INVITE}>{en('notFound.ask')}</a>
      </span>{' '}
      ·{' '}
      <span lang="fr">
        {fr('notFound.question')} <a href={DISCORD_INVITE}>{fr('notFound.ask')}</a>
      </span>
    </p>
  </main>

  <SiteFooter langs={['en', 'fr']} />
</BaseLayout>

<style>
  .not-found {
    max-width: 36rem;
    margin: 0 auto;
    padding: clamp(3rem, 15vh, 8rem) 1rem 2rem;
    text-align: center;
  }

  .code {
    margin: 0;
    color: var(--color-accent);
    font-size: 3rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.5rem 0 0.25rem;
  }

  p {
    color: var(--color-muted);
  }

  /* (each way out whole on its line on a small phone) */
  p a {
    white-space: nowrap;
  }

  .help {
    margin-top: 1.5rem;
  }

  .help > span {
    display: inline-block;
  }
</style>
