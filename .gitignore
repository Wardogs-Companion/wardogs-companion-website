# ceux de la console, marqués .game., où qu'ils soient (public/, src/ ou ailleurs). Un renommage passerait : la règle
# de CLAUDE.md prime.
/public/media/
opening-clip.mp4
opening-last-4k.jpg
littlebird-*.jpg
*.game.*
